{
  "name": "icimik-composer",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Chinese fiction workbench",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite --host 0.0.0.0",
    "test": "node --test tests/unit/*.test.cjs",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/e2e/launch-smoke.spec.cjs",
    "design:build": "node scripts/design.cjs",
    "design:check": "node scripts/design.cjs --check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/docs-check.cjs",
    "check": "npm run lint && npm run format:check && npm run docs:check && npm run build && npm test && npm run design:check",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.71.1",
    "vite": "^6.4.4",
    "yaml": "2.9.1"
  },
  "build": {
    "appId": "fun.kimmy.icimik.composer",
    "productName": "Icimik Composer",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "framework/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
